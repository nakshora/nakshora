{
  "name": "@nakshora/cli",
  "version": "3.0.0",
  "description": "Nakshora command-line interface — init, build, dev, inspect and AI export",
  "keywords": [
    "cli",
    "css",
    "framework",
    "build-tool",
    "jit",
    "nakshora"
  ],
  "license": "MIT",
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "rizwan@bsdc.info.bd"
  },
  "homepage": "https://nakshora.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakshora/nakshora",
    "directory": "packages/@nakshora/cli"
  },
  "bugs": {
    "url": "https://github.com/nakshora/nakshora/issues"
  },
  "type": "module",
  "bin": {
    "nakshora": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nakshora/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "globby": "^14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
