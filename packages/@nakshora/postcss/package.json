{
  "name": "@nakshora/postcss",
  "version": "3.0.0",
  "description": "Nakshora PostCSS plugin for seamless integration",
  "type": "module",
  "main": "./dist/postcss.cjs",
  "module": "./dist/postcss.esm.js",
  "types": "./dist/postcss.d.ts",
  "exports": {
    ".": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.esm.js",
      "require": "./dist/postcss.cjs",
      "default": "./dist/postcss.esm.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "nakshora",
    "utility-first"
  ],
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "rizwan@bsdc.info.bd"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakshora/nakshora",
    "directory": "packages/@nakshora/postcss"
  },
  "bugs": {
    "url": "https://github.com/nakshora/nakshora/issues"
  },
  "homepage": "https://nakshora.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nakshora/core": "workspace:*",
    "globby": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "postcss": "^8.4.32",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
