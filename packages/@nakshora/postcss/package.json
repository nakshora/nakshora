{
  "name": "@nakshora/postcss",
  "version": "3.1.0",
  "description": "Nakshora PostCSS plugin — @nakshora source / utilities with full JIT support",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "css",
    "utility-first",
    "jit",
    "nakshora"
  ],
  "license": "MIT",
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "rizwan@bsdc.info.bd"
  },
  "homepage": "https://nakshora.bsdc.info.bd",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakshora/nakshora",
    "directory": "packages/@nakshora/postcss"
  },
  "bugs": {
    "url": "https://github.com/nakshora/nakshora/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nakshora/core": "workspace:*",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^20.0.0",
    "postcss": "^8.4.32",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
