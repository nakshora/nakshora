{
  "name": "@nakshora/docs-site",
  "version": "1.0.0",
  "private": true,
  "description": "Nakshora Docs — the official documentation platform for the Nakshora CSS framework (docs.nakshora.bsdc.info.bd). React + Vite + TypeScript, statically pre-rendered, SEO & LLM optimized.",
  "type": "module",
  "homepage": "https://docs.nakshora.bsdc.info.bd",
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "rizwan@bsdc.info.bd"
  },
  "maintainers": [
    {
      "name": "RRC Development",
      "email": "rrc@bsdc.info.bd",
      "url": "https://rrc.bsdc.info.bd"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "generate": "node scripts/generate-content.mjs",
    "brand": "node scripts/brand.mjs",
    "build:vite": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "build": "npm run generate && npm run brand && npm run build:vite && npm run prerender && npm run postbuild",
    "dev": "npm run generate && vite",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
