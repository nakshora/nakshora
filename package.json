{
  "name": "nakshora",
  "version": "3.0.0",
  "private": true,
  "description": "The modern, ultra-fast, utility-first CSS framework — pnpm monorepo root",
  "homepage": "https://nakshora.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakshora/nakshora"
  },
  "bugs": {
    "url": "https://github.com/nakshora/nakshora/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "rizwan@bsdc.info.bd"
  },
  "maintainers": [
    {
      "name": "RRC Development",
      "email": "rrc@bsdc.info.bd",
      "url": "https://rrc.bsdc.info.bd"
    }
  ],
  "keywords": [
    "css",
    "framework",
    "utility-first",
    "tailwind",
    "responsive",
    "jit",
    "compiler",
    "postcss",
    "vite",
    "cli",
    "monorepo"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/generate-css.mjs",
    "build:core": "pnpm -F @nakshora/core build",
    "build:cli": "pnpm -F @nakshora/cli build",
    "build:postcss": "pnpm -F @nakshora/postcss build",
    "build:vite": "pnpm -F @nakshora/vite-plugin build",
    "dev": "pnpm -F @nakshora/cli build:watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "type-check": "pnpm -r type-check",
    "benchmark": "node scripts/benchmark.mjs",
    "ai:export": "pnpm build:cli && node packages/@nakshora/cli/dist/cli.js export:ai --out ai/corpus.json",
    "clean": "pnpm -r exec rm -rf dist && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "version": "changeset version",
    "publish:packages": "changeset publish",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
